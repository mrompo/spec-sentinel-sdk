#!/usr/bin/env bash
# pre-commit — la Esclusa, primer tiempo: secretos, entorno, formato y lint, SOLO sobre lo que
# está en staging. Los tests no se ejecutan aquí: son del segundo tiempo (pre-push).
# Patrón skip-vs-fail: herramienta ausente → aviso y se sigue; entorno roto → fallo duro con
# la instrucción de arreglo. Nunca pasa en silencio.
# Falsifica: SC-git-gates-03, 06, 07, 08, 09 (fixture/githooks/cases/).
set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HOOK_DIR/../adapters/stack.sh" 2>/dev/null || {
  echo "✗ [Esclusa] pre-commit: falta $HOOK_DIR/../adapters/stack.sh — reinstala el SDK (setup)" >&2
  exit 1
}

warn() { echo "⚠ [Esclusa] $1" >&2; }
fail=0
bad() { echo "✗ [Esclusa] $1" >&2; fail=1; }

# Ficheros en staging (añadidos, copiados, modificados, renombrados); los borrados no se evalúan
files=()
while IFS= read -r -d '' f; do files+=("$f"); done \
  < <(git diff --cached --name-only --diff-filter=ACMR -z)
[ "${#files[@]}" -gt 0 ] || exit 0

# ── 1. Secretos ───────────────────────────────────────────────────────────────────
# Base de patrones: corre siempre, sin dependencias. Se evalúa el contenido STAGEADO (:fichero),
# no el del árbol de trabajo. gitleaks, si está, amplía la cobertura.
SECRET_RE='(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}|-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{36}|xox[baprs]-[A-Za-z0-9-]{10,}'
leaks=""
for f in "${files[@]}"; do
  lines="$(git show ":$f" 2>/dev/null | grep -nIE "$SECRET_RE" | cut -d: -f1 | tr '\n' ',' || true)"
  [ -n "$lines" ] && leaks="${leaks}    ${f} (línea ${lines%,})"$'\n'
done
if [ -n "$leaks" ]; then
  bad "Posible secreto en staging (el contenido no se muestra):"
  printf '%s' "$leaks" >&2
  echo "    Sácalo del fichero y usa una variable de entorno o un gestor de secretos." >&2
fi

GITLEAKS="${SENTINEL_GITLEAKS_BIN:-gitleaks}"
if command -v "$GITLEAKS" >/dev/null 2>&1; then
  out="$("$GITLEAKS" protect --staged --no-banner --redact 2>&1)"; rc=$?
  case "$rc" in
    0) ;;
    1) bad "gitleaks ha encontrado secretos en staging:"; printf '%s\n' "$out" | sed 's/^/    /' >&2 ;;
    *) bad "gitleaks ha fallado (exit $rc) — revisa su instalación:"; printf '%s\n' "$out" | sed 's/^/    /' >&2 ;;
  esac
else
  warn "gitleaks no está instalado: se omite su análisis (sigue activa la base de patrones). Instálalo: https://github.com/gitleaks/gitleaks#installing"
fi

# ── 2. Comandos del adaptador de stack ────────────────────────────────────────────
if ! stack_available; then
  warn "sin adaptador de stack ($(stack_file)): se omiten env-ready, format-check y lint"
  exit "$fail"
fi

# El entorno roto es fallo duro: si env-ready falla, lo demás no es fiable
env_cmd="$(stack_get env-ready)"
if [ -n "$env_cmd" ] && ! bash -c "$env_cmd" >/dev/null 2>&1; then
  fix="$(stack_get env-fix)"
  bad "El entorno no está listo: «${env_cmd}» ha fallado (env-ready)."
  if [ -n "$fix" ]; then
    echo "    Arreglo: $fix" >&2
  else
    echo "    Ejecuta «${env_cmd}» para ver qué falla. Declara env-fix en stack.yaml para mostrar aquí la instrucción." >&2
  fi
  exit 1
fi

# format-check y lint reciben SOLO los ficheros en staging
for key in format-check lint; do
  cmd="$(stack_get "$key")"
  [ -n "$cmd" ] || continue
  out="$(bash -c "$cmd \"\$@\"" _ "${files[@]}" 2>&1)"; rc=$?
  case "$rc" in
    0) ;;
    127) warn "«${key}» está declarado pero «${cmd}» no está instalado: se omite" ;;
    *) bad "«${key}» ha fallado:"; printf '%s\n' "$out" | sed 's/^/    /' >&2 ;;
  esac
done

[ "$fail" -eq 0 ] || echo "El commit no se ha creado. Corrige lo anterior y vuelve a commitear." >&2
exit "$fail"
